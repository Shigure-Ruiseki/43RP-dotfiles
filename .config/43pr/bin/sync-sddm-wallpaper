#!/usr/bin/env bash
# Sync a 43PR wallpaper to SilentSDDM (both lock and login screens).
# Usage: sync-silent-wallpaper /path/to/image-or-video
set -euo pipefail

THEME=/usr/share/sddm/themes/silent
NAME=43pr-wallpaper.jpg

if (($# != 1)); then
    printf 'Usage: %s IMAGE_OR_VIDEO\n' "${0##*/}" >&2
    exit 2
fi
src=$1
[[ -f "$src" && -r "$src" ]] || { echo "Cannot read: $src" >&2; exit 1; }
[[ -f "$THEME/metadata.desktop" ]] || { echo "SilentSDDM is not installed: $THEME" >&2; exit 1; }
command -v ffmpeg >/dev/null || { echo 'ffmpeg is required.' >&2; exit 1; }
command -v python3 >/dev/null || { echo 'python3 is required.' >&2; exit 1; }
command -v flock >/dev/null || { echo 'flock is required (util-linux).' >&2; exit 1; }

# Serialize concurrent wallpaper changes from HyprQuickPaper.
mkdir -p "${XDG_CACHE_HOME:-$HOME/.cache}/43pr"
exec 9>"${XDG_CACHE_HOME:-$HOME/.cache}/43pr/silent-wallpaper.lock"
flock -x 9

# SilentSDDM loads a preset indicated by ConfigFile in metadata.desktop.
config_rel=$(python3 - "$THEME/metadata.desktop" <<'PY'
import configparser, sys
c = configparser.ConfigParser(interpolation=None)
c.optionxform = str
c.read(sys.argv[1], encoding='utf-8')
print(c.get('SddmGreeterTheme', 'ConfigFile', fallback='').strip())
PY
)
if [[ ! "$config_rel" =~ ^configs/[A-Za-z0-9._-]+\.conf$ ]]; then
    echo "Unexpected ConfigFile in metadata.desktop: $config_rel" >&2
    exit 1
fi
config="$THEME/$config_rel"
[[ -f "$config" ]] || { echo "Missing config: $config" >&2; exit 1; }

# Convert the first frame into a standard JPEG; supports still images, GIFs, videos.
tmp=$(mktemp --suffix=.jpg)
trap 'rm -f "$tmp"' EXIT
ffmpeg -hide_banner -loglevel error -nostdin -y -i "$src" -frames:v 1 -q:v 3 "$tmp"
[[ -s "$tmp" ]] || { echo 'ffmpeg produced an empty image.' >&2; exit 1; }

# Only this fixed file is written to the system theme.
dest="$THEME/backgrounds/$NAME"
[[ -f "$dest" && -w "$dest" ]] || {
    echo "Not writable: $dest (create it and grant file ACL once)" >&2
    exit 1
}
[[ -w "$config" ]] || {
    echo "Not writable: $config (grant file ACL once)" >&2
    exit 1
}
# Write into the existing inode so its file-specific ACL is preserved.
cat "$tmp" > "$dest"

# Update the selected config without rewriting other preset options or comments.
python3 - "$config" "$NAME" <<'PY'
import pathlib, re, sys
path = pathlib.Path(sys.argv[1]); filename = sys.argv[2]
original = path.read_text(encoding='utf-8')
text = original
for section in ('LockScreen', 'LoginScreen'):
    section_re = re.compile(r'(?m)^\[' + re.escape(section) + r'\][ \t]*$')
    match = section_re.search(text)
    if not match:
        raise SystemExit(f'Missing required section [{section}] in {path}')
    start = match.end()
    next_section = re.search(r'(?m)^\[', text[start:])
    end = start + next_section.start() if next_section else len(text)
    block = text[start:end]
    for key, value in (('background', f'"{filename}"'), ('use-background-color', 'false')):
        key_re = re.compile(r'(?m)^[ \t]*' + re.escape(key) + r'[ \t]*=.*$')
        if key_re.search(block):
            block = key_re.sub(f'{key} = {value}', block, count=1)
        else:
            block = f'\n{key} = {value}' + block
    text = text[:start] + block + text[end:]
if text != original:
    # Do not use os.replace(): the user has write ACL on the file, not its directory.
    with path.open('r+', encoding='utf-8') as f:
        f.seek(0)
        f.write(text)
        f.truncate()
PY
printf 'SilentSDDM wallpaper synced: %s -> %s/backgrounds/%s\n' "$src" "$THEME" "$NAME"
printf 'Active preset: %s\n' "$config_rel"
